---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { TRAILERS } from "../data/content";
import donut from "../assets/props/donut.png";
---

<section class="trailers section" id="trailers" aria-labelledby="trailers-title">
  <div class="container trailers__layout">
    <div class="trailers__aside">
      <header class="heading" data-reveal>
        <p class="heading__label">Exhibit D · 예고편</p>
        <h2 class="heading__title" id="trailers-title">테이프를<br />돌려 보죠</h2>
        <p class="heading__en" lang="en">Roll the tape.</p>
        <p class="heading__lead">공식 예고편만 모았습니다. 재생 버튼을 누르기 전까지는 YouTube에 아무것도 요청하지 않아요.</p>
      </header>
      <figure class="donut" data-reveal style="--delay: .15s">
        <div class="donut__swing" aria-hidden="true">
          <Picture src={donut} formats={["avif"]} fallbackFormat="webp" widths={[200, 400]} sizes="200px" alt="" loading="lazy" />
        </div>
        <figcaption>이 도넛이 왜 여기 있는지는<br />영화를 보면 압니다.</figcaption>
      </figure>
    </div>

    <ul class="reels" role="list">
      {
        TRAILERS.map((t, i) => (
          <li class:list={["reel", { "reel--feature": i === 0 }]} data-reveal style={`--delay:${i * 0.08}s`}>
            <button class="reel__button" type="button" data-video-open={t.id} data-video-title={`「나이브스 아웃」 ${t.title}`}>
              <span class="reel__screen" aria-hidden="true">
                <video class="reel__video" muted loop playsinline preload="none" data-poster={`/media/${t.preview}.webp`} data-preview={`/media/${t.preview}.webm|/media/${t.preview}.mp4`} tabindex="-1" />
                <span class="reel__play">
                  <Icon name="play" />
                </span>
              </span>
              <span class="reel__title">{t.title}</span>
              <span class="reel__meta">
                {t.meta} · {t.by}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trailers {
    background:
      radial-gradient(ellipse 60% 70% at 85% 30%, rgba(0, 40, 84, 0.55), transparent 70%),
      linear-gradient(#000c1a, var(--navy) 50%, #000a15);
  }
  .trailers__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .trailers__aside {
    position: sticky;
    top: calc(var(--hud-h) + 32px);
  }
  /* the aside is a narrow column: sized so "돌려 보죠" keeps to one line */
  .trailers__aside .heading__title {
    font-size: clamp(38px, 5.2vw, 72px);
  }

  .donut {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    margin-top: 12px;
  }
  .donut__swing {
    width: 110px;
    flex: none;
    transform-origin: 50% 0;
    animation: swing 4.5s var(--ease-io) infinite;
  }
  .donut__swing :global(img) {
    width: 100%;
  }
  @keyframes swing {
    0%,
    100% {
      rotate: -4deg;
    }
    50% {
      rotate: 4deg;
    }
  }
  .donut figcaption {
    padding-bottom: 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .reels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 32px);
  }
  .reel--feature {
    grid-column: 1 / -1;
  }
  .reel__button {
    display: grid;
    gap: 6px;
    width: 100%;
    text-align: left;
  }
  .reel__screen {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 2.39;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #000;
    margin-bottom: 8px;
  }
  .reel__screen::after {
    /* projector light */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.55));
    transition: opacity 0.4s;
  }
  .reel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease-out), filter 0.6s;
    filter: saturate(0.85) brightness(0.86);
  }
  .reel__button:hover .reel__video,
  .reel__button:focus-visible .reel__video {
    transform: scale(1.06);
    filter: none;
  }
  .reel__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border: 1px solid rgba(239, 201, 0, 0.7);
    border-radius: 50%;
    color: var(--gold);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    transition: transform 0.4s var(--ease-out), background-color 0.3s, color 0.3s;
  }
  .reel__play :global(svg) {
    width: 26px;
    height: 26px;
    margin-left: 3px;
  }
  .reel__button:hover .reel__play {
    background: var(--gold);
    color: var(--ink);
    transform: scale(1.08);
  }
  .reel__title {
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    line-height: 1.35;
  }
  .reel--feature .reel__title {
    font-size: clamp(22px, 2.4vw, 30px);
  }
  .reel__meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .trailers__layout {
      grid-template-columns: 1fr;
    }
    .trailers__aside {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .reels {
      grid-template-columns: 1fr;
    }
  }
</style>
