---
import Icon from "./Icon.astro";
import { CREDITS, LINKS } from "../data/content";
---

<section class="credits section" id="watch" aria-labelledby="watch-title">
  <div class="container credits__layout">
    <div>
      <header class="heading" data-reveal>
        <p class="heading__label">Closing the File · 감상 정보</p>
        <h2 class="heading__title" id="watch-title">직접 확인하세요</h2>
        <p class="heading__en" lang="en">The truth is in the film.</p>
      </header>
      <div class="credits__actions" data-reveal>
        <a class="btn btn--solid" href={LINKS.justwatch} target="_blank" rel="noopener">
          지금 볼 수 있는 곳 (JustWatch) <Icon name="external" />
        </a>
        <a class="btn" href={LINKS.youtubeMovies} target="_blank" rel="noopener">
          YouTube 영화 <Icon name="external" />
        </a>
      </div>
      <p class="credits__small" data-reveal>스트리밍 서비스 목록은 자주 바뀌어서, 항상 최신인 JustWatch로 연결합니다.</p>
    </div>

    <dl class="credits__list" data-reveal style="--delay: .1s">
      {
        CREDITS.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
      <div>
        <dt>수상 후보</dt>
        <dd>제92회 아카데미 각본상 · 제77회 골든글로브 3개 부문</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .credits {
    background: linear-gradient(#0b0907, #120d09);
  }
  .credits__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .credits__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .credits__small {
    margin-top: 14px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-faint);
  }
  .credits__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .credits__list div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15px;
  }
  .credits__list dt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--gold);
  }
  .credits__list dd {
    color: var(--text-dim);
  }

  @media (max-width: 820px) {
    .credits__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
