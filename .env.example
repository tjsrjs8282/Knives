# Copy to .env.local and fill in. Only GEMINI_API_KEY is read at runtime (/api/blanc);
# without it the page works fully and the detective's office says Blanc is out on a case.
GEMINI_API_KEY=
# Optional override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Asset tooling only (npm run assets:sfx / assets:upscale) — never shipped.
ELEVENLABS_API_KEY=
FAL_KEY=
